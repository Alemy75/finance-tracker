{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "family-finance-tracker",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "ACCOUNT_SETUP_KEY"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-finance-tracker",
      "database_id": "89d897f1-326e-4b89-a9e2-41c80f5aa0f4",
      "preview_database_id": "family-finance-local",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "secrets": { "required": ["BETTER_AUTH_SECRET", "ACCOUNT_SETUP_KEY"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "family-finance-tracker-staging",
          "database_id": "012cb22c-ef3b-4637-9435-2ab3150ad7e0",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
